# Sahara AI Worker - Environment Configuration
# Copy this to .env and fill in your values

# Choose your LLM provider:
# - ollama: Local Ollama (free, runs offline)
# - openwebui: OpenWebUI API (if you have it running)
# - openai: OpenAI API (requires API key)

LLM_PROVIDER=ollama

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# OpenWebUI settings (if LLM_PROVIDER=openwebui)
OPENWEBUI_BASE_URL=http://localhost:8080/v1
OPENWEBUI_API_KEY=your_openwebui_api_key_here

# OpenAI settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your_openai_api_key_here
