# Sahara AI Worker - Environment Configuration
# Copy this to .env and fill in your values

# Choose your LLM provider:
# - ollama: Local Ollama (free, runs offline)
# - openwebui: OpenWebUI API (if you have it running)
# - openai: OpenAI API (requires API key)

LLM_PROVIDER=ollama

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_BASE_URL=http://localhost:11434

# OpenWebUI settings (if LLM_PROVIDER=openwebui)
OPENWEBUI_BASE_URL=http://localhost:8080/v1
OPENWEBUI_API_KEY=your_openwebui_api_key_here

# OpenAI settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your_openai_api_key_here

# ─────────────────────────────────────────────
# SMTP — App Password Email (Scan-to-Mail style)
# Set these in Cloudflare Dashboard → Pages → Settings → Environment Variables
# Gmail: enable 2FA → myaccount.google.com/apppasswords → generate 16-char password
# Outlook: enable 2FA → account.microsoft.com/security → app passwords
# ─────────────────────────────────────────────
# These are read from Admin → Settings panel (stored in D1 DB).
# The env vars below are only fallbacks if the DB is not yet seeded.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@saharaprinter.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Sahara Office Equipments
MAIL_TO=inquiries@saharaprinter.com

# ─────────────────────────────────────────────
# RESEND — automatic email fallback
# If Gmail SMTP fails to send (throttled, app password rotated, etc.), the
# app retries the same email through Resend and alerts ADMIN_EMAIL. Get a
# key at resend.com → API Keys. Also settable in Admin → Settings (D1 wins
# over this env var).
# ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ─────────────────────────────────────────────
# GOOGLE REVIEWS — live rating/review-count badge + schema
# Set these in Cloudflare Dashboard → Pages → Settings → Environment Variables
# GOOGLE_PLACES_API_KEY: Google Cloud Console → enable "Places API (New)" → create key
# GOOGLE_PLACE_ID: the Place ID for the Sahara Office Equipments GBP listing
# Without these set, the site falls back to the last cached value (seeded 5.0★/69 reviews)
# ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_places_api_key_here
GOOGLE_PLACE_ID=your_place_id_here

# ─────────────────────────────────────────────
# ADMIN CREDENTIALS
# Set in Cloudflare Dashboard → Pages → sahara-website → Settings → Environment Variables
# Never commit real values to git
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@sahara.ae
ADMIN_PASSWORD=your_secure_password_here
