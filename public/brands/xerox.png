	<style>
		/* CRITICAL CSS: Variables, Header, HomeBanner */
		:root {
			--bg-primary: #ffffff;
			--text-primary: #333333;
			--text-secondary: #666666;
			--card-bg: #ffffff;
			--border-color: #e0e0e0;
			--border-radius: 12px;
