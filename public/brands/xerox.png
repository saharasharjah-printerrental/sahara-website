		}

		.col-md-6 {
			width: 50%;
		}

		.contact {
			display: flex;
			align-items: center;
			justify-content: end;
		}

		.cnt-optn {
			border-right: 1px solid #000000;
			padding-right: 10px;
		}

		.call-icon {
			width: 45px;
			height: 45px;
			background-color: #d64b00;
			border-radius: 50px;
			display: flex;
			align-items: center;
			justify-content: center;
			margin-left: 10px;
		}

		.cnt-optn p {
			text-align: right;
			margin: 0;
		}

		#email {
			color: #d64b00;
			font-weight: 400;
		}

		#num {
			color: #000162;
		}

		.mainMenu {
			display: flex;
			align-items: center;
		}

		.mainMenu ul {
			display: flex;
			align-items: center;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.mainMenu ul li {
			padding: 0 10px;
		}

		.mainMenu ul li a {
			font-size: 16px;
			font-weight: 600;
			text-transform: uppercase;
			text-decoration: none;
			color: inherit;
		}

		.toggle {
			display: none;
		}

		@media (max-width: 900px) {
			.mainMenu {
				display: none;
			}

			.toggle {
				display: block;
			}

			.col-md-3,
			.col-md-6 {
				width: auto;
			}

			.hdrContain .row {
				justify-content: space-between;
			}
		}

		/* HomeBanner Critical */
		.hero-Container {
			padding-top: 0 !important;
		}

		.heroSection {
			width: 100%;
			min-height: 500px;
			position: relative;
			padding: 30px 30px 30px 50px;
			overflow: hidden;
		}

		.heroSection__bg {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
			z-index: 0;
		}

		.heroSection__content {
			position: relative;
			z-index: 1;
		}

		.promo-card {
			margin: 0 auto;
			max-width: 1300px;
			width: 100%;
			border-radius: 0;
			overflow: hidden;
			box-shadow: none;
			display: flex;
			flex-direction: column;
