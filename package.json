{
  "name": "sahara-printer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "next build && npx @cloudflare/next-on-pages --skip-build",
    "start": "next start",
    "deploy": "npm run build:cf && npx wrangler pages deploy .vercel/output/static --project-name=saharaprinter",
    "test:e2e": "node tests/scripts/run-all-tests.js",
    "test:smoke": "bash tests/scripts/run-smoke-tests.sh",
    "test:visual": "bash tests/scripts/run-visual-tests.sh",
    "test:a11y": "bash tests/scripts/run-a11y-tests.sh",
    "test:screenshots": "bash tests/scripts/run-screenshot-tests.sh",
    "browser:install": "node node_modules/agent-browser/bin/agent-browser.js install --with-deps",
    "browser:doctor": "node node_modules/agent-browser/bin/agent-browser.js doctor"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "framer-motion": "^11.18.2",
    "next": "^15",
    "nodemailer": "^8.0.7",
    "react": "^19",
    "react-dom": "^19",
    "react-redux": "^9.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@agent-browser-io/browser": "^0.3.0",
    "@cloudflare/next-on-pages": "^1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.27.0",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.85.0",
    "zod": "^4.4.3"
  }
}
